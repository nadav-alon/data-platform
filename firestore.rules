rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    /** Whether the signed-in caller is `uid` themselves. */
    function isSelf(uid) {
      return isSignedIn() && uid == request.auth.uid;
    }

    /** A Household's gate: signed in, and recorded as `members/{uid}`. */
    function isMember() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    /**
     * First-claim: while `meta/household` doesn't exist, a signed-in user may create it as
     * long as the same batch also creates their own `members/{uid}` doc — see
     * `claimsOwnMembership()`. `allow create` alone already restricts this to a Household
     * that doesn't yet exist.
     */
    function claimsHousehold() {
      return isSignedIn()
        && request.resource.data.owner == request.auth.uid
        && existsAfter(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    /** The other half of first-claim: `uid`'s own doc, batched with `claimsHousehold()`. */
    function claimsOwnMembership(uid) {
      return isSelf(uid)
        && !exists(/databases/$(database)/documents/meta/household)
        && existsAfter(/databases/$(database)/documents/meta/household)
        && getAfter(/databases/$(database)/documents/meta/household).data.owner == request.auth.uid;
    }

    /** Whether `uid` is recorded as the Household's owner in `meta/household`. */
    function isRecordedOwner(uid) {
      return get(/databases/$(database)/documents/meta/household).data.owner == uid;
    }

    /** The Member who claimed the Household; same data access as any Member. */
    function isOwner() {
      return isMember() && isRecordedOwner(request.auth.uid);
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function isState(value) {
      return value in ['enough', 'running low', 'out'];
    }

    /** Matches `barcodeSchema`: a GTIN, digits only, length 8, 12, 13 or 14. */
    function isBarcode(value) {
      return value is string && value.matches('^([0-9]{8}|[0-9]{12}|[0-9]{13}|[0-9]{14})$');
    }

    /** Matches `z.array(barcodeSchema)`. Only the first element is checked: rules can't loop over a list. */
    function isValidBarcodes(value) {
      return value is list && (value.size() == 0 || isBarcode(value[0]));
    }

    /** Matches `itemSchema`: extra fields tolerate additive evolution. */
    function isValidItem(data) {
      return isNonEmptyString(data.name)
        && isState(data.state)
        && (!('brandNote' in data) || data.brandNote is string)
        && (!('barcodes' in data) || isValidBarcodes(data.barcodes));
    }

    /** Matches `stateHistoryEntrySchema`; `at` must be the server's own commit time. */
    function isValidStateHistoryEntry(data) {
      return isState(data.state) && data.at == request.time;
    }

    function isNecessity(value) {
      return value in ['essential', 'important', 'optional'];
    }

    /** How many other documents reference this one; never negative. */
    function isReferenceCount(value) {
      return value is int && value >= 0;
    }

    function shopPath(id) {
      return /databases/$(database)/documents/shops/$(id);
    }

    function categoryPath(id) {
      return /databases/$(database)/documents/categories/$(id);
    }

    /**
     * Whether the doc at `path`'s `referenceCount` moves by exactly `delta` in this write's
     * batch, comparing its state before (`get`) and after (`getAfter`) the whole batch commits.
     * The doc that adds, removes, or changes a reference must carry this adjustment for the
     * doc(s) it references, in the same batch — never the referenced doc's own rule, which has
     * no way to tell which referencing write is responsible for a given change.
     */
    function refCountAdjustedBy(path, delta) {
      return getAfter(path).data.referenceCount == get(path).data.referenceCount + delta;
    }

    /**
     * Whether a Category update correctly moves its `defaultShopId` reference: no adjustment
     * required when it's unchanged, otherwise the old Shop's referenceCount must drop by 1 and
     * the new Shop's must rise by 1, in the same batch.
     */
    function categoryShopReferenceAdjusted(oldData, newData) {
      return oldData.defaultShopId == newData.defaultShopId
        || (refCountAdjustedBy(shopPath(oldData.defaultShopId), -1)
          && refCountAdjustedBy(shopPath(newData.defaultShopId), 1));
    }

    /** Matches `catalogueItemSchema`. */
    function isValidCatalogueItem(data) {
      return isNonEmptyString(data.categoryId)
        && isNecessity(data.necessity)
        && (!('shopId' in data) || isNonEmptyString(data.shopId));
    }

    /** Matches `categorySchema`. */
    function isValidCategory(data) {
      return isNonEmptyString(data.name)
        && isNonEmptyString(data.defaultShopId)
        && isReferenceCount(data.referenceCount);
    }

    /** Matches `shopSchema`. */
    function isValidShop(data) {
      return isNonEmptyString(data.name) && isReferenceCount(data.referenceCount);
    }

    /**
     * Approximates `memberSchema`'s `email`: a non-empty string, not the full `z.email()`
     * format check, which `firestore.rules` can't express.
     */
    function isValidMember(data) {
      return isNonEmptyString(data.email);
    }

    /**
     * `isValidMember` plus `addedAt`'s create-only contract: like `stateHistory`'s `at`
     * (`isValidStateHistoryEntry`), it must be the server's own commit time.
     */
    function isValidNewMember(data) {
      return isValidMember(data) && data.addedAt == request.time;
    }

    match /meta/{doc} {
      allow get, list: if isMember();
    }

    match /meta/household {
      /** A missing doc (unclaimed Household) reads as not-exists. */
      allow get: if isSignedIn();
      allow create: if claimsHousehold();
      allow update, delete: if false;
    }

    match /meta/platform {
      /** A missing doc (`meta/platform` not yet written) reads as not-exists. */
      allow get: if isSignedIn();
      /** Written by household deploy using Admin SDK credentials, which bypass this rule entirely. */
      allow write: if false;
    }

    match /members/{uid} {
      /** A non-member may only `get` their own doc, so they can tell whether they've been added. */
      allow get: if isMember() || isSelf(uid);
      allow list: if isMember();
      allow create: if (claimsOwnMembership(uid) || isOwner()) && isValidNewMember(request.resource.data);
      /** `addedAt` is set once, on create; an update may not change it. */
      allow update: if isOwner()
        && isValidMember(request.resource.data)
        && request.resource.data.addedAt == resource.data.addedAt;
      /**
       * Never the Owner's own doc: meta/household is immutable, so its loss would leave the
       * Household without an Owner for good.
       */
      allow delete: if isOwner() && !isRecordedOwner(uid);
    }

    match /items/{itemId} {
      allow read: if isMember();
      allow create, update: if isMember() && isValidItem(request.resource.data);
      allow delete: if isMember();

      match /stateHistory/{entryId} {
        allow read: if isMember();
        allow create: if isMember() && isValidStateHistoryEntry(request.resource.data);
        allow update, delete: if false;
      }
    }

    /** The Shop a CatalogueItem overrides its Category's default with, or `null` when unset. */
    function catalogueItemShopId(data) {
      return ('shopId' in data) ? data.shopId : null;
    }

    /**
     * Whether a CatalogueItem update correctly moves its `categoryId` reference: no adjustment
     * required when it's unchanged, otherwise the old Category's referenceCount must drop by 1
     * and the new Category's must rise by 1, in the same batch.
     */
    function categoryReferenceAdjusted(oldData, newData) {
      return oldData.categoryId == newData.categoryId
        || (refCountAdjustedBy(categoryPath(oldData.categoryId), -1)
          && refCountAdjustedBy(categoryPath(newData.categoryId), 1));
    }

    /**
     * Whether a CatalogueItem update correctly moves its optional `shopId` override: no
     * adjustment for whichever end (old, new, or both) has no Shop set, otherwise that end's
     * Shop referenceCount must move by 1 in the corresponding direction, in the same batch.
     */
    function shopReferenceAdjusted(oldData, newData) {
      return catalogueItemShopId(oldData) == catalogueItemShopId(newData)
        || (
          (catalogueItemShopId(oldData) == null
            || refCountAdjustedBy(shopPath(catalogueItemShopId(oldData)), -1))
          && (catalogueItemShopId(newData) == null
            || refCountAdjustedBy(shopPath(catalogueItemShopId(newData)), 1))
        );
    }

    match /catalogueItems/{itemId} {
      allow read: if isMember();
      /**
       * A new CatalogueItem's `categoryId` must bump that Category's referenceCount in the same
       * batch; its optional `shopId` override, when set, must likewise bump that Shop's.
       */
      allow create: if isMember()
        && isValidCatalogueItem(request.resource.data)
        && refCountAdjustedBy(categoryPath(request.resource.data.categoryId), 1)
        && (catalogueItemShopId(request.resource.data) == null
          || refCountAdjustedBy(shopPath(catalogueItemShopId(request.resource.data)), 1));
      allow update: if isMember()
        && isValidCatalogueItem(request.resource.data)
        && categoryReferenceAdjusted(resource.data, request.resource.data)
        && shopReferenceAdjusted(resource.data, request.resource.data);
      /**
       * Deleting a CatalogueItem drops its Category reference, and its Shop override's when set,
       * in the same batch.
       */
      allow delete: if isMember()
        && refCountAdjustedBy(categoryPath(resource.data.categoryId), -1)
        && (catalogueItemShopId(resource.data) == null
          || refCountAdjustedBy(shopPath(catalogueItemShopId(resource.data)), -1));
    }

    match /categories/{categoryId} {
      allow read: if isMember();
      /**
       * A new Category starts unreferenced: nothing has had the chance to point at it yet. Its
       * own `defaultShopId` reference must bump that Shop's referenceCount in the same batch.
       */
      allow create: if isMember()
        && isValidCategory(request.resource.data)
        && request.resource.data.referenceCount == 0
        && refCountAdjustedBy(shopPath(request.resource.data.defaultShopId), 1);
      allow update: if isMember()
        && isValidCategory(request.resource.data)
        && categoryShopReferenceAdjusted(resource.data, request.resource.data);
      /**
       * Denied while anything still references this Category (its own referenceCount), and its
       * own outgoing reference to its default Shop must be dropped in the same batch.
       */
      allow delete: if isMember()
        && resource.data.referenceCount == 0
        && refCountAdjustedBy(shopPath(resource.data.defaultShopId), -1);
    }

    match /shops/{shopId} {
      allow read: if isMember();
      /** A new Shop starts unreferenced: nothing has had the chance to point at it yet. */
      allow create: if isMember()
        && isValidShop(request.resource.data)
        && request.resource.data.referenceCount == 0;
      allow update: if isMember() && isValidShop(request.resource.data);
      /** Denied while anything still references this Shop (its own referenceCount). */
      allow delete: if isMember() && resource.data.referenceCount == 0;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
