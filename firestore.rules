rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    /** Whether the signed-in caller is `uid` themselves. */
    function isSelf(uid) {
      return isSignedIn() && uid == request.auth.uid;
    }

    /** A Household's gate: signed in, and recorded as `members/{uid}`. */
    function isMember() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    /**
     * First-claim: while `meta/household` doesn't exist, a signed-in user may create it as
     * long as the same batch also creates their own `members/{uid}` doc — see
     * `claimsOwnMembership()`. `allow create` alone already restricts this to a Household
     * that doesn't yet exist.
     */
    function claimsHousehold() {
      return isSignedIn()
        && request.resource.data.owner == request.auth.uid
        && existsAfter(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    /**
     * The other half of first-claim: `uid`'s own doc, recording their verified token email,
     * batched with `claimsHousehold()`.
     */
    function claimsOwnMembership(uid) {
      return isSelf(uid)
        && hasVerifiedEmail()
        && recordsOwnEmail()
        && !exists(/databases/$(database)/documents/meta/household)
        && existsAfter(/databases/$(database)/documents/meta/household)
        && getAfter(/databases/$(database)/documents/meta/household).data.owner == request.auth.uid;
    }

    /** Whether `uid` is recorded as the Household's owner in `meta/household`. */
    function isRecordedOwner(uid) {
      return get(/databases/$(database)/documents/meta/household).data.owner == uid;
    }

    /** The Member who claimed the Household; same data access as any Member. */
    function isOwner() {
      return isMember() && isRecordedOwner(request.auth.uid);
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function isState(value) {
      return value in ['enough', 'running low', 'out'];
    }

    /** Matches `barcodeSchema`: a GTIN, digits only, length 8, 12, 13 or 14. */
    function isBarcode(value) {
      return value is string && value.matches('^([0-9]{8}|[0-9]{12}|[0-9]{13}|[0-9]{14})$');
    }

    /** Matches `z.array(barcodeSchema)`. Only the first element is checked: rules can't loop over a list. */
    function isValidBarcodes(value) {
      return value is list && (value.size() == 0 || isBarcode(value[0]));
    }

    /** Matches `deletedAtSchema`: absent, or a timestamp. A `null` is neither, so it never gets through. */
    function isValidDeletedAt(data) {
      return !('deletedAt' in data) || data.deletedAt is timestamp;
    }

    /** When `data` was soft-deleted, or `null` while it is live (no `deletedAt`). */
    function deletedAtOf(data) {
      return ('deletedAt' in data) ? data.deletedAt : null;
    }

    function isDeleted(data) {
      return deletedAtOf(data) != null;
    }

    /**
     * A doc is created live: a soft delete is an update, so the counts a live doc holds are
     * released by one write that can be checked against them.
     */
    function isCreatedLive(data) {
      return !isDeleted(data);
    }

    /**
     * An update leaves `deletedAt` as it was, or clears it (a restore), or, on a live doc, sets
     * it to the server's own commit time. A doc that stays soft-deleted keeps its original time.
     */
    function deletedAtUpdateValid(oldData, newData) {
      return deletedAtOf(oldData) == deletedAtOf(newData)
        || !isDeleted(newData)
        || (isSoftDeleting(oldData, newData) && newData.deletedAt == request.time);
    }

    /** Whether an update sets `deletedAt` on a live doc. */
    function isSoftDeleting(oldData, newData) {
      return !isDeleted(oldData) && isDeleted(newData);
    }

    /** Whether an update clears `deletedAt` on a soft-deleted doc. */
    function isRestoring(oldData, newData) {
      return isDeleted(oldData) && !isDeleted(newData);
    }

    /** Matches `itemSchema`: extra fields tolerate additive evolution. */
    function isValidItem(data) {
      return isNonEmptyString(data.name)
        && isState(data.state)
        && isValidDeletedAt(data)
        && (!('brandNote' in data) || data.brandNote is string)
        && (!('barcodes' in data) || isValidBarcodes(data.barcodes));
    }

    /** Matches `stateHistoryEntrySchema`; `at` must be the server's own commit time. */
    function isValidStateHistoryEntry(data) {
      return isState(data.state) && data.at == request.time;
    }

    function isNecessity(value) {
      return value in ['essential', 'important', 'optional'];
    }

    /** How many other documents reference this one; never negative. */
    function isReferenceCount(value) {
      return value is int && value >= 0;
    }

    function shopPath(id) {
      return /databases/$(database)/documents/shops/$(id);
    }

    function categoryPath(id) {
      return /databases/$(database)/documents/categories/$(id);
    }

    function memberPath(uid) {
      return /databases/$(database)/documents/members/$(uid);
    }

    function invitePath(id) {
      return /databases/$(database)/documents/invites/$(id);
    }

    function itemPath(id) {
      return /databases/$(database)/documents/items/$(id);
    }

    function catalogueItemPath(id) {
      return /databases/$(database)/documents/catalogueItems/$(id);
    }

    /**
     * Whether the doc at `path`'s `referenceCount` moves by exactly `delta` in this write's
     * batch, comparing its state before (`get`) and after (`getAfter`) the whole batch commits.
     * The doc that adds, removes, or changes a reference must carry this adjustment for the
     * doc(s) it references, in the same batch — never the referenced doc's own rule, which has
     * no way to tell which referencing write is responsible for a given change.
     *
     * `get`/`getAfter` see the whole batch's before/after state, so this only holds for a batch
     * that touches `path` through one reference change. A batch that adds, removes, or moves two
     * references to the same target in one go (two new CatalogueItems in one Category, say) needs
     * a net delta this check can't express, and is denied — one write per referencing change per
     * target, per batch.
     */
    function referenceCountAdjustedBy(path, delta) {
      return getAfter(path).data.referenceCount == get(path).data.referenceCount + delta;
    }

    /**
     * Whether the doc at `path` is live before this batch. A write that points at a Shop or
     * Category needs it live then, not merely after the batch: restoring a Category and the Shop
     * it names takes one batch each.
     */
    function isLiveAt(path) {
      return !isDeleted(get(path).data);
    }

    /**
     * Whether an update leaves a reference needing no liveness check: it names nothing, or it is
     * unchanged on a doc that isn't being restored, so its target already holds a count a
     * Category or Shop can't be soft-deleted under.
     */
    function referenceKept(oldData, newData, oldId, newId) {
      return newId == null || (!isRestoring(oldData, newData) && oldId == newId);
    }

    /**
     * Whether a Category update leaves its default Shop live: a soft-deleted Category references
     * nothing, and a live one that keeps its Shop already holds a count on it, which a Shop can't
     * be soft-deleted under. Only a new or restored reference, or a moved one, is checked.
     */
    function categoryUpdateNamesLiveShop(oldData, newData) {
      return isDeleted(newData)
        || referenceKept(oldData, newData, oldData.defaultShopId, newData.defaultShopId)
        || isLiveAt(shopPath(newData.defaultShopId));
    }

    /** Whether a new CatalogueItem's Category, and Shop override when set, are live. */
    function catalogueItemNamesLiveTargets(data) {
      return isLiveAt(categoryPath(data.categoryId))
        && (catalogueItemShopId(data) == null || isLiveAt(shopPath(catalogueItemShopId(data))));
    }

    /**
     * `categoryUpdateNamesLiveShop` for a CatalogueItem's Category and Shop override: each is
     * checked only when it is new, moved, or restored.
     */
    function catalogueItemUpdateNamesLiveTargets(oldData, newData) {
      return isDeleted(newData)
        || ((referenceKept(oldData, newData, oldData.categoryId, newData.categoryId)
            || isLiveAt(categoryPath(newData.categoryId)))
          && (referenceKept(oldData, newData, catalogueItemShopId(oldData), catalogueItemShopId(newData))
            || isLiveAt(shopPath(catalogueItemShopId(newData)))));
    }

    /**
     * Whether a Category update correctly moves its `defaultShopId` reference: no adjustment
     * required when it's unchanged, otherwise the old Shop's referenceCount must drop by 1 and
     * the new Shop's must rise by 1, in the same batch.
     */
    function categoryShopReferenceAdjusted(oldData, newData) {
      return oldData.defaultShopId == newData.defaultShopId
        || (referenceCountAdjustedBy(shopPath(oldData.defaultShopId), -1)
          && referenceCountAdjustedBy(shopPath(newData.defaultShopId), 1));
    }

    /**
     * Whether a Category update, live or soft-deleted on either side, keeps its reference to its
     * default Shop counted exactly while it is live. A live Category holds one count on its
     * default Shop; a soft-deleted one holds none, so:
     *
     * - live to live: `categoryShopReferenceAdjusted`;
     * - soft delete: only at `referenceCount == 0`, with the default Shop unchanged and dropped by 1;
     * - restore: the default Shop it names afterwards (possibly a new one) rises by 1;
     * - soft-deleted to soft-deleted: the default Shop stays as it was, with nothing to adjust.
     */
    function categoryReferencesValid(oldData, newData) {
      return (!isDeleted(oldData) && !isDeleted(newData)
          && categoryShopReferenceAdjusted(oldData, newData))
        || (isSoftDeleting(oldData, newData)
          && oldData.referenceCount == 0
          && newData.referenceCount == 0
          && oldData.defaultShopId == newData.defaultShopId
          && referenceCountAdjustedBy(shopPath(oldData.defaultShopId), -1))
        || (isRestoring(oldData, newData)
          && referenceCountAdjustedBy(shopPath(newData.defaultShopId), 1))
        || (isDeleted(oldData) && isDeleted(newData)
          && oldData.defaultShopId == newData.defaultShopId);
    }

    /** The Shop a CatalogueItem overrides its Category's default with, or `null` when unset. */
    function catalogueItemShopId(data) {
      return ('shopId' in data) ? data.shopId : null;
    }

    /**
     * Whether a CatalogueItem's Shop override has its Shop's referenceCount move by `delta`
     * in the same batch; vacuously true when `data` has no override to adjust.
     */
    function catalogueItemShopReferenceAdjustedBy(data, delta) {
      return catalogueItemShopId(data) == null
        || referenceCountAdjustedBy(shopPath(catalogueItemShopId(data)), delta);
    }

    /**
     * Whether a CatalogueItem update correctly moves its `categoryId` reference: no adjustment
     * required when it's unchanged, otherwise the old Category's referenceCount must drop by 1
     * and the new Category's must rise by 1, in the same batch.
     */
    function catalogueItemCategoryReferenceAdjusted(oldData, newData) {
      return oldData.categoryId == newData.categoryId
        || (referenceCountAdjustedBy(categoryPath(oldData.categoryId), -1)
          && referenceCountAdjustedBy(categoryPath(newData.categoryId), 1));
    }

    /**
     * Whether a CatalogueItem update correctly moves its optional `shopId` override: no
     * adjustment for whichever end (old, new, or both) has no Shop set, otherwise that end's
     * Shop referenceCount must move by 1 in the corresponding direction, in the same batch.
     */
    function catalogueItemShopReferenceAdjusted(oldData, newData) {
      return catalogueItemShopId(oldData) == catalogueItemShopId(newData)
        || (catalogueItemShopReferenceAdjustedBy(oldData, -1)
          && catalogueItemShopReferenceAdjustedBy(newData, 1));
    }

    /**
     * Whether a CatalogueItem update, live or soft-deleted on either side, keeps its references
     * to its Category and optional Shop override counted exactly while it is live. As with a
     * Category (`categoryReferencesValid`): a live one holds a count on each, a soft-deleted one
     * holds none.
     *
     * - live to live: the old and new references are moved with `catalogueItemCategoryReferenceAdjusted`
     *   and `catalogueItemShopReferenceAdjusted`;
     * - soft delete: both references unchanged, and each dropped by 1;
     * - restore: each reference it names afterwards (possibly new ones) rises by 1;
     * - soft-deleted to soft-deleted: both references stay as they were, with nothing to adjust.
     */
    function catalogueItemReferencesValid(oldData, newData) {
      return (!isDeleted(oldData) && !isDeleted(newData)
          && catalogueItemCategoryReferenceAdjusted(oldData, newData)
          && catalogueItemShopReferenceAdjusted(oldData, newData))
        || (isSoftDeleting(oldData, newData)
          && catalogueItemReferencesUnchanged(oldData, newData)
          && referenceCountAdjustedBy(categoryPath(oldData.categoryId), -1)
          && catalogueItemShopReferenceAdjustedBy(oldData, -1))
        || (isRestoring(oldData, newData)
          && referenceCountAdjustedBy(categoryPath(newData.categoryId), 1)
          && catalogueItemShopReferenceAdjustedBy(newData, 1))
        || (isDeleted(oldData) && isDeleted(newData)
          && catalogueItemReferencesUnchanged(oldData, newData));
    }

    function catalogueItemReferencesUnchanged(oldData, newData) {
      return oldData.categoryId == newData.categoryId
        && catalogueItemShopId(oldData) == catalogueItemShopId(newData);
    }

    /** Whether the doc at `path`, when it exists after the batch, has the same `deletedAt` as `data`. */
    function deletedAtMatchesAt(path, data) {
      return !existsAfter(path) || deletedAtOf(getAfter(path).data) == deletedAtOf(data);
    }

    /**
     * A CatalogueItem and the Item it extends are soft-deleted together: when the `items` doc
     * exists after the batch, its `deletedAt` is the CatalogueItem's own.
     */
    function itemDeletedAtMatches(itemId, catalogueItemData) {
      return deletedAtMatchesAt(itemPath(itemId), catalogueItemData);
    }

    /** The other half of `itemDeletedAtMatches`: an Item's `deletedAt` follows its CatalogueItem's. */
    function catalogueItemDeletedAtMatches(itemId, itemData) {
      return deletedAtMatchesAt(catalogueItemPath(itemId), itemData);
    }

    /** Matches `catalogueItemSchema`. */
    function isValidCatalogueItem(data) {
      return isNonEmptyString(data.categoryId)
        && isNecessity(data.necessity)
        && isValidDeletedAt(data)
        && (!('shopId' in data) || isNonEmptyString(data.shopId));
    }

    /** Matches `categorySchema`. */
    function isValidCategory(data) {
      return isNonEmptyString(data.name)
        && isNonEmptyString(data.defaultShopId)
        && isReferenceCount(data.referenceCount)
        && isValidDeletedAt(data);
    }

    /** A Shop is soft-deleted only while nothing references it, as a hard delete is. */
    function shopSoftDeleteAllowed(oldData, newData) {
      return !isSoftDeleting(oldData, newData)
        || (oldData.referenceCount == 0 && newData.referenceCount == 0);
    }

    /** Matches `shopSchema`. */
    function isValidShop(data) {
      return isNonEmptyString(data.name)
        && isReferenceCount(data.referenceCount)
        && isValidDeletedAt(data);
    }

    /**
     * Approximates `memberSchema`'s `email`: a non-empty string, not the full `z.email()`
     * format check, which `firestore.rules` can't express.
     */
    function isValidMember(data) {
      return isNonEmptyString(data.email);
    }

    /**
     * `isValidMember` plus `addedAt`'s create-only contract: like `stateHistory`'s `at`
     * (`isValidStateHistoryEntry`), it must be the server's own commit time.
     */
    function isValidNewMember(data) {
      return isValidMember(data) && data.addedAt == request.time;
    }

    /** Whether the caller's token carries a Google-verified email. */
    function hasVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    /** The caller's own token email, lowercased. */
    function ownLowercasedEmail() {
      return request.auth.token.email.lower();
    }

    /** The invite id the caller's own token email addresses: lowercased, as invites are keyed. */
    function ownInviteId() {
      return ownLowercasedEmail();
    }

    /** Whether the Member doc being created records the caller's own token email, lowercased. */
    function recordsOwnEmail() {
      return request.resource.data.email == ownLowercasedEmail();
    }

    /**
     * Joining, the Member-create half: `uid`'s own doc, recording their token email, allowed
     * while an invite for that verified email exists and only in a batch that spends it, so an
     * invite joins once. The other half is the invite's own delete rule.
     */
    function joinsWithInvite(uid) {
      return isSelf(uid)
        && hasVerifiedEmail()
        && recordsOwnEmail()
        && exists(invitePath(ownInviteId()))
        && !existsAfter(invitePath(ownInviteId()));
    }

    /**
     * Joining, the invite-delete half: the invitee spends their own invite, and only once the
     * same batch leaves them a Member.
     */
    function spendsOwnInvite(inviteId) {
      return hasVerifiedEmail()
        && inviteId == ownInviteId()
        && existsAfter(memberPath(request.auth.uid));
    }

    /** Matches `inviteSchema`; `invitedAt` must be the server's own commit time. */
    function isValidNewInvite(inviteId, data) {
      return inviteId == inviteId.lower() && data.invitedAt == request.time;
    }

    match /meta/{doc} {
      allow get, list: if isMember();
    }

    match /meta/household {
      /** A missing doc (unclaimed Household) reads as not-exists. */
      allow get: if isSignedIn();
      allow create: if claimsHousehold();
      allow update, delete: if false;
    }

    match /meta/platform {
      /** A missing doc (`meta/platform` not yet written) reads as not-exists. */
      allow get: if isSignedIn();
      /** Written by household deploy using Admin SDK credentials, which bypass this rule entirely. */
      allow write: if false;
    }

    match /members/{uid} {
      /** A non-member may only `get` their own doc, so they can tell whether they've been added. */
      allow get: if isMember() || isSelf(uid);
      allow list: if isMember();
      allow create: if (claimsOwnMembership(uid) || isOwner() || joinsWithInvite(uid)) && isValidNewMember(request.resource.data);
      /** `addedAt` is set once, on create; an update may not change it. */
      allow update: if isOwner()
        && isValidMember(request.resource.data)
        && request.resource.data.addedAt == resource.data.addedAt;
      /**
       * Never the Owner's own doc: meta/household is immutable, so its loss would leave the
       * Household without an Owner for good.
       */
      allow delete: if isOwner() && !isRecordedOwner(uid);
    }

    match /invites/{inviteId} {
      /** `get` is limited to the invite keyed by the caller's own email; any Member can `list`. */
      allow get: if isSignedIn() && inviteId == ownInviteId();
      allow list: if isMember();
      allow create: if isOwner() && isValidNewInvite(inviteId, request.resource.data);
      allow delete: if isOwner() || spendsOwnInvite(inviteId);
    }

    match /items/{itemId} {
      allow read: if isMember();
      allow create: if isMember()
        && isValidItem(request.resource.data)
        && isCreatedLive(request.resource.data);
      allow update: if isMember()
        && isValidItem(request.resource.data)
        && deletedAtUpdateValid(resource.data, request.resource.data)
        && catalogueItemDeletedAtMatches(itemId, request.resource.data);
      /** Soft delete (`deletedAt`) is the only way an app deletes; the console's admin access can still hard delete. */
      allow delete: if false;

      match /stateHistory/{entryId} {
        allow read: if isMember();
        allow create: if isMember() && isValidStateHistoryEntry(request.resource.data);
        allow update, delete: if false;
      }
    }

    match /catalogueItems/{itemId} {
      allow read: if isMember();
      /**
       * A new CatalogueItem's `categoryId` must bump that Category's referenceCount in the same
       * batch; its optional `shopId` override, when set, must likewise bump that Shop's.
       */
      allow create: if isMember()
        && isValidCatalogueItem(request.resource.data)
        && isCreatedLive(request.resource.data)
        && catalogueItemNamesLiveTargets(request.resource.data)
        && referenceCountAdjustedBy(categoryPath(request.resource.data.categoryId), 1)
        && catalogueItemShopReferenceAdjustedBy(request.resource.data, 1);
      allow update: if isMember()
        && isValidCatalogueItem(request.resource.data)
        && deletedAtUpdateValid(resource.data, request.resource.data)
        && catalogueItemUpdateNamesLiveTargets(resource.data, request.resource.data)
        && catalogueItemReferencesValid(resource.data, request.resource.data)
        && itemDeletedAtMatches(itemId, request.resource.data);
      /** Soft delete (`deletedAt`) is the only way an app deletes; the console's admin access can still hard delete. */
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if isMember();
      /**
       * A new Category starts unreferenced: nothing has had the chance to point at it yet. Its
       * own `defaultShopId` reference must bump that Shop's referenceCount in the same batch.
       */
      allow create: if isMember()
        && isValidCategory(request.resource.data)
        && isCreatedLive(request.resource.data)
        && isLiveAt(shopPath(request.resource.data.defaultShopId))
        && request.resource.data.referenceCount == 0
        && referenceCountAdjustedBy(shopPath(request.resource.data.defaultShopId), 1);
      allow update: if isMember()
        && isValidCategory(request.resource.data)
        && deletedAtUpdateValid(resource.data, request.resource.data)
        && categoryUpdateNamesLiveShop(resource.data, request.resource.data)
        && categoryReferencesValid(resource.data, request.resource.data);
      /** Soft delete (`deletedAt`) is the only way an app deletes; the console's admin access can still hard delete. */
      allow delete: if false;
    }

    match /shops/{shopId} {
      allow read: if isMember();
      /** A new Shop starts unreferenced: nothing has had the chance to point at it yet. */
      allow create: if isMember()
        && isValidShop(request.resource.data)
        && isCreatedLive(request.resource.data)
        && request.resource.data.referenceCount == 0;
      allow update: if isMember()
        && isValidShop(request.resource.data)
        && deletedAtUpdateValid(resource.data, request.resource.data)
        && shopSoftDeleteAllowed(resource.data, request.resource.data);
      /** Denied while anything still references this Shop (its own referenceCount). */
      allow delete: if isMember() && resource.data.referenceCount == 0;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
