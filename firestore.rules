rules_version = '2';

// TODO[#7]: add per-collection validation matching this repo's zod schemas.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    /** A Household's gate: signed in, and recorded as `members/{uid}`. */
    function isMember() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    match /meta/household {
      allow read: if isMember();
      allow write: if false;
    }

    match /meta/platform {
      allow read: if isMember();
      // TODO[#9]: household deploy writes this.
      allow write: if false;
    }

    match /members/{uid} {
      allow read: if isMember();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
